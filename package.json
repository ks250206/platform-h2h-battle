{
  "name": "platform-h2h-battle",
  "version": "0.1.0",
  "private": true,
  "description": "BRAMBLE — heavy swords, little paws. A 3D platform arena fighter.",
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0",
    "build": "tsc --noEmit && vp build",
    "preview": "vp preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "test:e2e": "playwright test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@pixi/3d": "0.1.0",
    "pixi.js": "8.23.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  },
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.21.0"
}
